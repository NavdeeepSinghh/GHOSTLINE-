; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ghostline"
config/description="A third-person action-adventure set in 2097, twenty years after The Silence."
config/version="1.4.1"
run/main_scene="res://scenes/main/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Ghostline"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.027, 0.035, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

UserDataMigration="*res://scripts/core/user_data_migration.gd"
InputSetup="*res://scripts/core/input_setup.gd"
EventBus="*res://scripts/core/event_bus.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/save/save_manager.gd"
MissionManager="*res://scripts/progression/mission_manager.gd"
CombatFX="*res://scripts/combat/combat_fx.gd"
MusicDirector="*res://scripts/audio/music_director.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_cast=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[editor]

export/convert_text_resources_to_binary=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="climbable"
3d_physics/layer_5="interactable"
3d_physics/layer_6="hurtbox"
3d_physics/layer_7="hitbox"
3d_physics/layer_8="trigger"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.02, 0.027, 0.035, 1)
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
environment/ssao/quality=1
environment/ssao/half_size=true
occlusion_culling/use_occlusion_culling=true
scaling_3d/mode=0
scaling_3d/scale=1.0
